# Copy to .env and fill in. .env is git-ignored.

# Jev, the model that scores an invoice's wording. https://console.typesafe.ai
TYPESAFE_API_KEY=

# PayPal sandbox app for the business being protected. Needs Invoicing and Transaction search.
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox apps that send invoices for the demo. Only used by scripts/demo-invoices.mts and spike/.
# Each needs Invoicing switched on. The emails are on the dashboard's Sandbox Accounts page.
PAYPAL_RECIPIENT_EMAIL=
PAYPAL_SENDER_CLIENT_ID=
PAYPAL_SENDER_CLIENT_SECRET=
PAYPAL_SENDER_EMAIL=
PAYPAL_NEWVENDOR_CLIENT_ID=
PAYPAL_NEWVENDOR_CLIENT_SECRET=
PAYPAL_NEWVENDOR_EMAIL=
PAYPAL_SCAMMER_CLIENT_ID=
PAYPAL_SCAMMER_CLIENT_SECRET=
PAYPAL_SCAMMER_EMAIL=

# Writes the plain-English explanations. Optional: without it the app lists the reasons as they are.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Postgres connection string. Leave unset locally to use an embedded database in .data/.
# DATABASE_URL=

# Shared password for the hosted demo. Leave unset locally.
# DEMO_PASSWORD=

# The address forwarded invoice emails go to, shown in the sidebar. Read at build time.
# NEXT_PUBLIC_INBOUND_ADDRESS=
